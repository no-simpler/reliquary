#!/usr/bin/env bash
#
# compose-gc — reclaims Docker Compose state left behind by git worktrees of the
# current repository.
#
# A worktree removed without tearing its stack down first leaves Docker state
# behind with the compose file gone. `docker compose down` can no longer reach
# such a project — it needs the file — so leftovers pile up: a surviving stack
# keeps a headless chromium (sometimes a whole db stack) alive, starving the
# machine until system-suite tests fail under the load, and even a fully-exited
# one pins its volumes for good. Sweeping by *label* needs no compose file.
#
# Leftovers come in two shapes and both must be handled — a container-only sweep
# goes blind the moment a stack's containers are gone but its volumes are not,
# which is the steady state after any teardown that omitted -v:
#
#   A. Containers, keyed on the directory of their
#      com.docker.compose.project.config_files label.
#   B. Volumes and networks whose project has no containers left, keyed on
#      project name — volumes carry no config-file label.
#
# Liveness is what spares a live worktree, and it is checked twice: the config
# directory still existing, and git still registering it as a worktree.
#
# Two worktree layouts are matched, because this machine has used both: the
# nested <repo>/.claude/worktrees/<name>/ and the older sibling checkout
# <root>/<repo>-<name>/. Anchoring on the nested shape alone leaves every stack
# from the older era permanently unreachable.
#
# Project name cannot prove provenance for a volume-only leftover, so sweep B
# additionally demands that the project's volume-name set match the live main
# project's exactly. That test is what holds unrelated tooling — a sibling
# repo's cargo cache, an IDE's helper volumes — out of range, and it is why the
# sweep no-ops safely when the main stack has never been raised.
#
# Removal is per-project, so one left half-removed still gets finished. Volume
# and network removal is label-scoped to the dead project alone, so shared or
# external volumes (labeled to the main project, or unlabeled) are never
# touched.
#
# Not side-effect-free, unlike the check-* scripts: it talks to the Docker
# daemon, which on a machine configured for it may start the daemon. That is
# inherent — the job is mutating Docker state.
#
# Usage:
#   compose-gc [-n|--dry-run]                 reconcile orphaned projects for this repo
#   compose-gc down <worktree-path> [-n]      profile-complete teardown of one stack
#   compose-gc --help
#
# Exit: 0 = clean (nothing to do, or swept without error); 1 = a removal failed
#       or a teardown reported a resource still in use; 2 = usage error.

set -o pipefail

# --- Colors (house style, see bin/check-bedrock) ---------------------------
BOLD="\033[1m"
RED="\033[31m"
GREEN="\033[32m"
DIM="\033[2m"
RESET="\033[0m"

FAILS=0

ok() { printf '%b\n' "  ${GREEN}✓${RESET} $1"; }
fail() {
    printf '%b\n' "  ${RED}✗${RESET} $1"
    FAILS=$((FAILS + 1))
}
note() { printf '%b\n' "      ${DIM}$1${RESET}"; }
hdr() { printf '%b\n' "${BOLD}==>${RESET} ${BOLD}$1${RESET}"; }

usage() {
    cat <<'USAGE'
compose-gc — reclaim Docker Compose state left behind by dead worktrees

  compose-gc [-n|--dry-run]              reconcile orphaned projects for this repo
  compose-gc down <path> [-n|--dry-run]  profile-complete teardown of one stack
  compose-gc --help

Scoped to the current repository: only projects whose compose file lived under
<repo>/.claude/worktrees/ or <root>/<repo>-* are ever considered, and a
volume-only leftover must additionally match the main stack's volume shape.
USAGE
}

# --- Args ------------------------------------------------------------------
DRY_RUN=0
SUB=""
TARGET=""

while [ $# -gt 0 ]; do
    case "$1" in
        -n | --dry-run) DRY_RUN=1 ;;
        -h | --help)
            usage
            exit 0
            ;;
        down) SUB="down" ;;
        -*)
            printf '%b\n' "${RED}unknown option: $1${RESET}" >&2
            usage >&2
            exit 2
            ;;
        *) if [ -z "$TARGET" ]; then TARGET="$1"; else
            printf '%b\n' "${RED}unexpected argument: $1${RESET}" >&2
            exit 2
        fi ;;
    esac
    shift
done

[ "$SUB" = "down" ] && [ -z "$TARGET" ] && {
    printf '%b\n' "${RED}down needs a worktree path${RESET}" >&2
    exit 2
}
[ -z "$SUB" ] && [ -n "$TARGET" ] && {
    printf '%b\n' "${RED}unexpected argument: $TARGET${RESET}" >&2
    exit 2
}

# --- Preconditions ---------------------------------------------------------
command -v docker >/dev/null 2>&1 || {
    note "docker not installed — nothing to do"
    exit 0
}
docker ps -q >/dev/null 2>&1 || {
    note "docker daemon unreachable — nothing to do"
    exit 0
}

# --- down: teardown of one worktree's stack --------------------------------
if [ "$SUB" = "down" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
        note "would tear down the compose project at $TARGET"
        exit 0
    fi
    out=$(docker compose --project-directory "$TARGET" --profile '*' down -v --remove-orphans 2>&1)
    rc=$?
    case "$out" in
        *"no configuration file"* | *"Can't find a suitable configuration file"*)
            note "no compose file at $TARGET — nothing to tear down"
            exit 0
            ;;
    esac
    case "$out" in
        *"Resource is still in use"*)
            printf '%s\n' "$out"
            fail "teardown left a resource in use — the reconcile sweep still has work"
            exit 1
            ;;
    esac
    if [ $rc -ne 0 ]; then
        printf '%s\n' "$out"
        fail "teardown of $TARGET failed"
        exit 1
    fi
    ok "tore down the compose project at $TARGET"
    exit 0
fi

# --- Repository anchor -----------------------------------------------------
# --git-common-dir, not --show-toplevel: from inside a linked worktree it still
# resolves to the main worktree.
COMMON=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
    note "not inside a git repository — nothing to do"
    exit 0
}
REPO=$(dirname "$COMMON")
[ -d "$REPO" ] || {
    note "no main worktree for this repository — nothing to do"
    exit 0
}
ROOT=$(dirname "$REPO")
NAME=$(basename "$REPO")

LIVE=$(git -C "$REPO" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')

is_live() { # a path git still registers, or one that is simply still there
    [ -n "$1" ] || return 1
    [ -d "$1" ] && return 0
    [ -n "$LIVE" ] || return 1
    printf '%s\n' "$LIVE" | grep -qxF -- "$1"
}

label_of() { # label_of <container-id> <label-key>
    docker inspect --format "{{ index .Config.Labels \"$2\" }}" "$1" 2>/dev/null
}

reclaim() { # label-scoped to one dead project
    local proj="$1" v n
    for v in $(docker volume ls -q --filter "label=com.docker.compose.project=$proj" 2>/dev/null); do
        if [ "$DRY_RUN" -eq 1 ]; then
            note "would remove volume $v"
        elif ! docker volume rm "$v" >/dev/null 2>&1; then
            fail "volume $v of $proj could not be removed"
        fi
    done
    for n in $(docker network ls -q --filter "label=com.docker.compose.project=$proj" 2>/dev/null); do
        if [ "$DRY_RUN" -eq 1 ]; then
            note "would remove network $n"
        elif ! docker network rm "$n" >/dev/null 2>&1; then
            fail "network $n of $proj could not be removed"
        fi
    done
}

signature() { # volume names of a project, with the project prefix stripped
    local proj="$1" v
    for v in $(docker volume ls -q --filter "label=com.docker.compose.project=$proj" 2>/dev/null); do
        printf '%s\n' "${v#"${proj}_"}"
    done | sort | tr '\n' ' '
}

SWEPT=0

# --- A. Containers of a vanished worktree ----------------------------------
for cid in $(docker ps -aq); do
    cf=$(label_of "$cid" com.docker.compose.project.config_files)
    [ -n "$cf" ] || continue
    d=$(dirname "${cf%%,*}")
    case "$d" in
        "$REPO"/.claude/worktrees/* | "$ROOT/$NAME"-*) : ;;
        *) continue ;;
    esac
    is_live "$d" && continue
    p=$(label_of "$cid" com.docker.compose.project)
    if [ "$DRY_RUN" -eq 1 ]; then
        note "would remove container $cid"
    elif ! docker rm -f -v "$cid" >/dev/null 2>&1; then
        fail "container $cid of $p could not be removed"
    fi
    reclaim "$p"
    SWEPT=$((SWEPT + 1))
    ok "reclaimed orphan container from: $p"
done

# --- B. Volume-only leftovers ----------------------------------------------
MAIN_SIG=$(signature "$NAME")
if [ -n "$MAIN_SIG" ]; then
    for p in $(docker volume ls --filter "label=com.docker.compose.project" \
        --format "{{ .Label \"com.docker.compose.project\" }}" | sort -u); do
        [ "$p" = "$NAME" ] && continue # the main stack itself
        is_live "$REPO/.claude/worktrees/$p" && continue
        is_live "$ROOT/$p" && continue # live sibling checkout or repo
        [ -n "$(docker ps -aq --filter "label=com.docker.compose.project=$p")" ] && continue
        [ "$(signature "$p")" = "$MAIN_SIG" ] || continue # foreign shape — not ours to reap
        reclaim "$p"
        SWEPT=$((SWEPT + 1))
        ok "reclaimed orphan volumes from: $p"
    done
else
    note "main stack never raised — no volume shape to match against"
fi

# --- Report ----------------------------------------------------------------
if [ "$DRY_RUN" -eq 1 ]; then
    hdr "compose-gc: $SWEPT orphaned project(s) would be swept from $NAME"
else
    hdr "compose-gc: swept $SWEPT orphaned project(s) from $NAME"
fi

[ "$FAILS" -gt 0 ] && exit 1
exit 0
