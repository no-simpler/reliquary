#!/usr/bin/env bash
#
# check-brew-health — surfaces Homebrew packages and Brewfile declarations that
# have rotted upstream, while they are still cheap to fix.
#
# Homebrew announces this class of decay only as unattributed noise during
# `brew update` ("Some installed kegs have no formulae!", "Some installed
# formulae are deprecated or disabled"), which scrolls past inside `up` and says
# nothing about what to do. This check names the package, the reason, the
# deadline, and the replacement — and, crucially, extends the same scrutiny to
# the Brewfiles, so a declaration that no longer resolves is caught here rather
# than on the next machine's bootstrap.
#
# What it checks:
#   1. Installed formulae and casks marked deprecated or disabled upstream.
#   2. Installed kegs orphaned by a formula's removal (tap-aware, so formulae
#      from third-party taps are not mistaken for orphans).
#   3. Brewfile entries that no longer resolve to any formula or cask.
#   4. Packages installed on request that are declared in no Brewfile — the
#      inverse drift, and the one that only shows up on a restore.
#
# Verification only — it never installs, uninstalls, taps or upgrades anything.
# It reads install receipts and Homebrew's local API cache, so it is offline on
# any machine that has run `brew update` at least once, and safe in the
# unattended `yadm doctor` dream pre-pass.
#
# Exit: 0 = healthy; 1 = healthy with warnings (something is on a clock);
#       2 = broken (a package or a declaration is no longer reproducible). The
#       0/1/2 split matches check-bedrock so `yadm doctor` can map results onto
#       its own ok/warn/fail counters.

set -o pipefail

# --- Colors (house style, see bin/check-bedrock) ---------------------------
BOLD="\033[1m"; RED="\033[31m"; GREEN="\033[32m"; YELLOW="\033[33m"; DIM="\033[2m"; RESET="\033[0m"

FAILS=0
WARNS=0

ok()   { printf '%b\n' "  ${GREEN}✓${RESET} $1"; }
warn() { printf '%b\n' "  ${YELLOW}!${RESET} $1"; WARNS=$((WARNS + 1)); }
fail() { printf '%b\n' "  ${RED}✗${RESET} $1"; FAILS=$((FAILS + 1)); }
note() { printf '%b\n' "      ${DIM}$1${RESET}"; }
head() { printf '%b\n' "${BOLD}==>${RESET} ${BOLD}$1${RESET}"; }

# Route a LEVEL<TAB>message line (the analysis helper's output format).
route() {
    local level="${1%%	*}" msg="${1#*	}"
    case "$level" in
        OK)   ok   "$msg" ;;
        WARN) warn "$msg" ;;
        FAIL) fail "$msg" ;;
        NOTE) note "$msg" ;;
        *)    note "$1" ;;
    esac
}

# --- Args ------------------------------------------------------------------
for a in "$@"; do
    case "$a" in
        -h|--help) echo "usage: check-brew-health"; exit 0 ;;
        *) printf 'check-brew-health: unknown argument: %s\n' "$a" >&2; exit 2 ;;
    esac
done

# --- Preconditions ---------------------------------------------------------
[ -t 1 ] && head "Homebrew package health"

if ! command -v brew >/dev/null 2>&1; then
    # Not a failure: Homebrew is macOS-only in Reliquary today, and a future
    # Linux machine has nothing to check here.
    ok "brew not installed — nothing to check"
    exit 0
fi

# Never let this check trigger a `brew update` of its own; it must stay fast and
# side-effect-free even when Homebrew thinks it is due for a refresh.
export HOMEBREW_NO_AUTO_UPDATE=1

BREW_CACHE="$(brew --cache 2>/dev/null)"
TAPS_ROOT="$(brew --repository 2>/dev/null)/Library/Taps"
FORMULA_NAMES="$BREW_CACHE/api/formula_names.txt"
CASK_NAMES="$BREW_CACHE/api/cask_names.txt"
BREW_DIR="$HOME/.config/brew"

# --- Checks 1–3: installed packages ----------------------------------------
# The helper runs `brew info --json=v2 --installed` itself rather than being fed
# it on stdin, because stdin is already spoken for by the heredoc carrying the
# helper. That one call merges install receipts with Homebrew's cached API data,
# which is where the deprecation metadata lives.
analysis="$(python3 - "$FORMULA_NAMES" "$CASK_NAMES" "$TAPS_ROOT" <<'PY'
import json
import os
import subprocess
import sys

formula_names_path, cask_names_path, taps_root = sys.argv[1:4]


def roster(path):
    """Names Homebrew currently ships in a core tap, or None if uncached."""
    try:
        with open(path, encoding="utf-8") as handle:
            return {line.strip() for line in handle if line.strip()}
    except OSError:
        return None


core_formulae = roster(formula_names_path)
core_casks = roster(cask_names_path)

out = []


def emit(level, message):
    out.append("%s\t%s" % (level, message))


def tap_dir(tap):
    """Local checkout of a third-party tap, e.g. atlassian/acli."""
    user, _, repo = tap.partition("/")
    return os.path.join(taps_root, user, "homebrew-" + repo)


def in_tap(tap, name, kind):
    """True if a tapped repo still carries this formula/cask.

    Taps are free to lay files out flat, under Formula/ or Casks/, sharded by
    first letter (as homebrew-core does), or under HomebrewFormula/ — so try
    every sanctioned location before calling something orphaned.
    """
    root = tap_dir(tap)
    if not os.path.isdir(root):
        return None  # tap not present on this machine — cannot judge
    sub = "Casks" if kind == "cask" else "Formula"
    candidates = [
        os.path.join(root, sub, name + ".rb"),
        os.path.join(root, sub, name[:1].lower(), name + ".rb"),
        os.path.join(root, name + ".rb"),
        os.path.join(root, "HomebrewFormula", name + ".rb"),
    ]
    return any(os.path.isfile(path) for path in candidates)


def replacement(pkg):
    """Homebrew's own pointer to what supersedes a deprecated package."""
    for key in (
        "deprecation_replacement_formula",
        "deprecation_replacement_cask",
        "disable_replacement_formula",
        "disable_replacement_cask",
    ):
        value = pkg.get(key)
        if value:
            kind = "cask" if key.endswith("_cask") else "formula"
            return "use the %s %s instead" % (kind, value)
    return None


try:
    raw = subprocess.run(
        ["brew", "info", "--json=v2", "--installed"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    data = json.loads(raw)
except (OSError, subprocess.CalledProcessError, ValueError) as exc:
    print("WARN\tcould not read installed-package data (%s)" % exc)
    raise SystemExit(0)

formulae = data.get("formulae", [])
casks = data.get("casks", [])

# --- 1. Deprecated or disabled ---------------------------------------------
rotting = []
for pkg, name, kind in (
    [(f, f.get("name", "?"), "formula") for f in formulae]
    + [(c, c.get("token", "?"), "cask") for c in casks]
):
    if pkg.get("disabled"):
        state, reason, date = "disabled", pkg.get("disable_reason"), pkg.get("disable_date")
    elif pkg.get("deprecated"):
        state, reason, date = "deprecated", pkg.get("deprecation_reason"), pkg.get("deprecation_date")
    else:
        continue
    detail = "%s %s — %s upstream" % (kind, name, state)
    if reason:
        detail += " (%s)" % reason
    if date:
        detail += "; %s on %s" % ("disabled" if state == "deprecated" else "removed", date)
    rotting.append((detail, replacement(pkg), name, kind))

if rotting:
    for detail, repl, name, kind in rotting:
        emit("WARN", detail)
        if repl:
            emit("NOTE", repl)
        elif kind == "formula" and core_casks and name in core_casks:
            emit("NOTE", "a cask named %s exists — declare it as a cask instead" % name)
else:
    emit("OK", "no installed formula or cask is deprecated or disabled")

# --- 2 & 3. Orphaned kegs ---------------------------------------------------
orphans = []
unjudged = []
for pkg, name, kind, core in (
    [(f, f.get("name", "?"), "formula", core_formulae) for f in formulae]
    + [(c, c.get("token", "?"), "cask", core_casks) for c in casks]
):
    tap = pkg.get("tap")
    if not tap:
        unjudged.append("%s %s installed outside any tap — cannot judge" % (kind, name))
        continue
    if tap in ("homebrew/core", "homebrew/cask"):
        if core is None:
            unjudged.append(
                "%s roster not cached (%s) — run `brew update`"
                % (kind, os.path.basename(formula_names_path if kind == "formula" else cask_names_path))
            )
            continue
        present = name in core
    else:
        present = in_tap(tap, name, kind)
        if present is None:
            unjudged.append("tap %s is not present on this machine — %s %s unjudged" % (tap, kind, name))
            continue
    if not present:
        hint = None
        if kind == "formula" and core_casks and name in core_casks:
            hint = "a cask named %s exists — reinstall it as a cask and update the Brewfile" % name
        orphans.append(("%s %s is installed but no longer exists in %s" % (kind, name, tap), hint))

if orphans:
    for detail, hint in orphans:
        emit("FAIL", detail)
        if hint:
            emit("NOTE", hint)
else:
    emit("OK", "every installed package still exists in its tap")

for message in sorted(set(unjudged)):
    emit("NOTE", message)

print("\n".join(out))
PY
)"

if [ -z "$analysis" ]; then
    warn "installed-package analysis produced no output (python3 failure?)"
else
    while IFS= read -r line; do
        [ -n "$line" ] && route "$line"
    done <<EOF
$analysis
EOF
fi

# --- Check 4: Brewfile declarations still resolve --------------------------
# The piece that actually prevents recurrence. A rotted `brew "name"` line is
# invisible until a fresh machine runs bootstrap or bbs and dies on it, which is
# the worst possible moment to discover it.
#
# Only Brewfiles present on disk are read: the encrypted scopes may not be
# decrypted on this machine, and their absence is not a problem to report.
brewfiles=""
for f in "$BREW_DIR"/Brewfile "$BREW_DIR"/Brewfile@*; do
    case "$f" in *.lock.json) continue ;; esac
    [ -f "$f" ] && brewfiles="${brewfiles:+$brewfiles }$f"
done

# Entries in a Brewfile whose leading keyword is $1 ("brew", "cask" or "tap").
declared() {
    # shellcheck disable=SC2086
    grep -hE "^[[:space:]]*$1[[:space:]]+\"" $brewfiles 2>/dev/null \
        | sed -E "s/^[[:space:]]*$1[[:space:]]+\"([^\"]+)\".*/\1/" \
        | sort -u
}

# Report every name in $2 ($1 = "formula"/"cask") that brew cannot resolve.
# A batch `brew info` settles the healthy case in one call; it aborts on the
# first unknown name without naming it, so the slow per-name pass runs only when
# something is already wrong.
check_declared() {
    local kind="$1" names="$2" flag missing n
    [ -n "$names" ] || return 0
    case "$kind" in
        formula) flag="--formula" ;;
        cask)    flag="--cask" ;;
    esac
    # shellcheck disable=SC2086
    brew info "$flag" --json=v2 $names >/dev/null 2>&1 && return 0

    missing=""
    for n in $names; do
        brew info "$flag" --json=v2 "$n" >/dev/null 2>&1 || missing="${missing:+$missing }$n"
    done
    [ -n "$missing" ] || return 0

    for n in $missing; do
        if [ "$UNTAPPED" = "1" ]; then
            # A tap the Brewfiles declare is not installed here, so this name may
            # be perfectly valid on a machine that has run bootstrap.
            warn "Brewfile declares $kind \"$n\", which does not resolve — but a declared tap is missing here, so this may be a false alarm"
        else
            fail "Brewfile declares $kind \"$n\", which no longer resolves to any $kind"
            if [ "$kind" = formula ] && [ -r "$CASK_NAMES" ] && grep -qxF "$n" "$CASK_NAMES"; then
                note "a cask named $n exists — change the line to cask \"$n\""
            fi
        fi
    done
    return 0
}

if [ -z "$brewfiles" ]; then
    warn "no Brewfiles found under $BREW_DIR"
else
    # A Brewfile-declared tap that is not installed here makes unresolvable names
    # ambiguous, so record that up front and soften the verdict accordingly.
    UNTAPPED=0
    for t in $(declared tap); do
        user="${t%%/*}"; repo="${t#*/}"
        [ -d "$TAPS_ROOT/$user/homebrew-$repo" ] || { UNTAPPED=1; note "tap $t is declared but not tapped on this machine"; }
    done

    before=$((FAILS + WARNS))
    check_declared formula "$(declared brew)"
    check_declared cask    "$(declared cask)"
    [ "$((FAILS + WARNS))" -eq "$before" ] \
        && ok "every Brewfile entry still resolves ($(echo $brewfiles | wc -w | tr -d ' ') file(s) read)"
fi

# --- Check 5: everything installed on request is declared somewhere ---------
# The inverse of check 4, and the failure it prevents is quieter: a package
# installed by hand, relied on by a repository, and named in no Brewfile survives
# only as long as this disk does. Nothing announces it — the tool is on $PATH, so
# every check passes right up until the restore that does not install it.
#
# `--installed-on-request` is the whole trick: it excludes packages pulled in as
# dependencies, which are reproduced by declaring their dependents and must not be
# declared themselves. Casks have no dependency lane, so all of them count.
#
# A warning, never a failure, for two reasons. A scope that is not decrypted on
# this machine is not read, so an undeclared verdict can be incomplete — the same
# caveat check 4 carries. And a machine is allowed to hold a package on purpose;
# `brew/undeclared` is where that decision is recorded so it stops resurfacing,
# exactly as `yadm/unmanaged` records a path nobody manages.
UNDECLARED_FILE="$BREW_DIR/undeclared"

# Names in a newline-separated list, tap prefixes dropped so `user/tap/name` and
# `name` compare equal — a Brewfile may spell either.
bare_names() { sed -E 's|.*/||' | sed -E 's/[[:space:]]+$//' | sort -u; }

if [ -z "$brewfiles" ]; then
    : # already reported above
else
    declared_all="$( { declared brew; declared cask; } | bare_names )"
    excused=""
    if [ -r "$UNDECLARED_FILE" ]; then
        excused="$(sed -E 's/#.*//' "$UNDECLARED_FILE" | awk 'NF {print $1}' | bare_names)"
    fi

    installed_wanted="$( { brew leaves --installed-on-request 2>/dev/null
                           brew list --cask 2>/dev/null; } | bare_names )"

    # The subtraction happens in awk, with both lists reaching it through the
    # environment rather than through -v: -v rescans its value for escapes, and an
    # awk array index is a byte string whatever the locale, where `==` is not.
    undeclared="$(SKIP="$declared_all
$excused" awk '
        BEGIN {
            n = split(ENVIRON["SKIP"], a, "\n")
            for (i = 1; i <= n; i++) if (a[i] != "") skip[a[i]] = 1
        }
        NF && !($0 in skip) { print }
    ' <<EOF
$installed_wanted
EOF
)"

    if [ -z "$undeclared" ]; then
        ok "every package installed on request is declared in a Brewfile"
    else
        for n in $undeclared; do
            warn "$n is installed on request but declared in no Brewfile — it will not survive a restore"
        done
        note "declare it, uninstall it, or record the decision in ${UNDECLARED_FILE#$HOME/}"
    fi
fi

# --- Summary ---------------------------------------------------------------
# Cosmetic only, and suppressed when the output is captured (e.g. `yadm doctor`
# via $(...)), which adds its own heading. Exit codes always apply.
if [ -t 1 ]; then
    echo
    if [ "$FAILS" -gt 0 ]; then
        printf '%b\n' "${BOLD}${RED}!!>${RESET} ${RED}Homebrew health BROKEN — $FAILS failure(s), $WARNS warning(s)${RESET}"
    elif [ "$WARNS" -gt 0 ]; then
        printf '%b\n' "${BOLD}${YELLOW}==>${RESET} ${YELLOW}Homebrew health ok with $WARNS warning(s)${RESET}"
    else
        printf '%b\n' "${BOLD}==>${RESET} ${BOLD}${GREEN}Homebrew health ok — nothing deprecated, orphaned or unresolvable${RESET}"
    fi
fi

[ "$FAILS" -gt 0 ] && exit 2
[ "$WARNS" -gt 0 ] && exit 1
exit 0
