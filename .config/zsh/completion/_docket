(( $+functions[_docket_commands] )) ||
_docket_commands() {
    local commands; commands=(
'list:List outstanding items' \
'ls:List outstanding items' \
'create:Open a new item and print where to write its body' \
'show:Print an item'\''s body' \
'path:Print an item'\''s file path, for writing or editing its body' \
'set:Change an item'\''s descriptive metadata' \
'reorder:Change where an item sits in the order' \
'promote:Advance an item one rung along the ladder' \
'relay:Consume a relay\: open its successor and archive it' \
'close:Archive an item whose work is done' \
'delete:Remove an item outright, leaving no archive copy' \
'doctor:Check the depot for damage' \
'announce:Emit the session-start announcement' \
'help:Explain a topic, or a command' \
'completions:Print a shell completion script' \
    )
    _describe -t commands 'docket commands' commands "$@"
}
